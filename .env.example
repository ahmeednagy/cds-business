# Local development environment — copy to .env and adjust if needed.
# All values below have safe defaults in compose.yaml; .env is only required
# to override them. .env is gitignored — never commit real secrets.

# PostgreSQL (db service + Django connection)
POSTGRES_DB=wasl
POSTGRES_USER=wasl
POSTGRES_PASSWORD=wasl_dev_password
# Host port published for psql/GUI access — change if local Postgres already uses 5432
POSTGRES_PORT=5432

# Django
#DJANGO_SECRET_KEY=dev-secret-key-for-local-docker
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend origin used in generated links (password reset emails)
#FRONTEND_URL=http://localhost:5173

# Vite /api proxy target — set to http://backend:8000 only inside the
# frontend container (compose.yaml does this already). Leave unset on host.
#VITE_API_PROXY_TARGET=http://localhost:8000
