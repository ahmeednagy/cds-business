# Development image — Django runserver with source mounted from the repo.
# Layout keeps REPO_ROOT=/app so MEDIA_ROOT resolves to /app/media (bind-mounted).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app/backend

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

EXPOSE 8000

# Migrations are applied by the compose command before runserver starts.
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
