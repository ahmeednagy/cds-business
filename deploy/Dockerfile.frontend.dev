# Development image — Vite dev server with source mounted from the repo.
FROM node:22-alpine

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

COPY frontend/ ./

EXPOSE 5173

# Vite listens on 0.0.0.0 inside the container; published as localhost:5173.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
